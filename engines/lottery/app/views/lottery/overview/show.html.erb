<% content_for(:title) { t("lottery.title") } %>

<div class="w-full">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white" data-native-page-title><%= t("lottery.title") %></h1>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to lottery.edit_account_path,
          class: "inline-flex items-center justify-center p-2 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-200",
          aria: { label: t("lottery.overview.account_settings") } do %>
        <%= lucide_icon "settings", class: "w-5 h-5" %>
      <% end %>
      <%= link_to lottery.new_purchase_path,
          class: "inline-flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 transition-colors duration-200" do %>
        <%= lucide_icon "ticket", class: "w-4 h-4" %>
        <%= t("lottery.overview.purchase") %>
      <% end %>
    </div>
  </div>

  <section id="lottery_balance" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm p-4 sm:p-5 mb-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <dl class="grid grid-cols-2 gap-6">
        <div>
          <dt class="text-sm text-gray-500 dark:text-gray-400"><%= t("lottery.overview.purchasable") %></dt>
          <dd class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("lottery.amount", amount: number_with_delimiter(@account.purchasable)) %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500 dark:text-gray-400"><%= t("lottery.overview.total_deposit") %></dt>
          <dd class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("lottery.amount", amount: number_with_delimiter(@account.total_deposit)) %></dd>
        </div>
      </dl>

      <div class="flex w-full sm:w-auto flex-row-reverse sm:flex-col items-center sm:items-end justify-between gap-2">
        <%= button_to lottery.sync_path,
            class: "inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200",
            data: { turbo_submits_with: t("lottery.overview.syncing") } do %>
          <%= lucide_icon "refresh-cw", class: "w-4 h-4" %>
          <%= t("lottery.overview.sync") %>
        <% end %>
        <% if @account.synced? %>
          <span class="text-xs text-gray-500 dark:text-gray-400"><%= t("lottery.overview.synced_at", time: @account.synced_at.strftime("%Y-%m-%d %H:%M")) %></span>
        <% end %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("lottery.overview.history_heading", days: Lottery::Synchronizer::HISTORY_DAYS) %></h2>

    <div id="purchase_records" class="space-y-3">
      <% if @purchase_records.any? %>
        <%= render partial: "lottery/overview/purchase_record", collection: @purchase_records %>
      <% else %>
        <div class="text-center py-12">
          <%= lucide_icon "ticket", class: "mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" %>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("lottery.overview.history_empty") %></p>
        </div>
      <% end %>
    </div>
  </section>
</div>
