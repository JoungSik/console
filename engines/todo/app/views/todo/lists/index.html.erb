<% content_for(:title) { "할 일 목록" } %>

<div class="w-full">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"
        data-native-page-title>할 일 목록</h1>
    <%= link_to todo.new_list_path, class: "self-start flex-shrink-0 inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800" do %>
      <%= lucide_icon "plus", class: "w-4 h-4 mr-1.5" %>
      새 할 일 목록
    <% end %>
  </div>

  <%= turbo_frame_tag "lists_frame" do %>
    <%= render "list_tabs", current_tab: @current_tab, lists: @lists %>
  <% end %>
</div>
