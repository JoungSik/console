const FIREBASE_MESSAGE_DATA_KEY = "FCM_MSG";

self.addEventListener("notificationclick", function(event) {
  event.stopImmediatePropagation();
  event.notification.close();

  const notificationData = event.notification.data || {};
  const firebaseMessage = notificationData[FIREBASE_MESSAGE_DATA_KEY] || {};
  const destination = notificationData.url ||
    firebaseMessage.fcmOptions?.link ||
    firebaseMessage.data?.url ||
    "/";
  const destinationUrl = new URL(destination, self.location.origin);

  if (destinationUrl.origin !== self.location.origin) return;

  event.waitUntil(
    clients.matchAll({ type: "window", includeUncontrolled: true })
      .then(function(clientList) {
        for (const client of clientList) {
          if (client.url.startsWith(self.location.origin) && "focus" in client) {
            return client.navigate(destinationUrl.href).then(function() {
              return client.focus();
            });
          }
        }

        return clients.openWindow(destinationUrl.href);
      })
  );
});

<% if @firebase_web_configured %>
importScripts("https://www.gstatic.com/firebasejs/12.17.1/firebase-app-compat.js");
importScripts("https://www.gstatic.com/firebasejs/12.17.1/firebase-messaging-compat.js");

firebase.initializeApp(<%= raw @firebase_web_config.to_json %>);
firebase.messaging();
<% end %>
