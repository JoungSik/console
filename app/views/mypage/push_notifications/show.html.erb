<% content_for(:title) { t('settings.push_notifications.page_title') } %>

<div class="w-full">
  <div class="mb-6"
       data-native-page-navigation>
    <%= link_to mypage_user_path, class: "inline-flex items-center gap-1 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200" do %>
      <%= lucide_icon "arrow-left", class: "w-4 h-4" %>
      <%= t('settings.mypage.title') %>
    <% end %>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white"
        data-native-page-title>
      <%= t('settings.push_notifications.page_title') %>
    </h1>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      <%= t('settings.push_notifications.page_description') %>
    </p>
  </div>

  <% if hotwire_native_app? %>
    <%= render "native_subscription_card" %>
  <% else %>
    <%= render "web_subscription_card" %>
  <% end %>

  <% if @notification_plugins.any? %>
    <% @notification_plugins.each do |plugin| %>
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm mb-6">
        <div class="p-6">
          <div class="flex items-center mb-4">
            <%= lucide_icon plugin.icon, class: "w-6 h-6 text-blue-600 dark:text-blue-400 mr-3" %>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
              <%= plugin.label %>
            </h2>
          </div>

          <div class="space-y-4">
            <% plugin.push_notification_items.each do |item| %>
              <% setting = @push_notification_settings[[plugin.name.to_s, item.key]] %>
              <% enabled = setting.nil? || setting.enabled? %>
              <%= render "notification_item", plugin: plugin, item: item, enabled: enabled %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm">
      <div class="p-6 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <%= t('settings.push_notifications.no_items') %>
        </p>
      </div>
    </div>
  <% end %>
</div>
