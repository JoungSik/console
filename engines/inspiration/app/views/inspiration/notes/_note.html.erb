<li id="<%= dom_id note %>" class="relative pl-5 border-l-2 border-blue-200 dark:border-blue-800">
  <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-blue-500 dark:bg-blue-400"></span>
  <div class="flex items-start justify-between gap-3">
    <span class="text-xs text-gray-500 dark:text-gray-400"><%= note.created_at.strftime("%Y-%m-%d %H:%M") %></span>
    <%= link_to inspiration.idea_note_path(idea, note),
        class: "inline-flex flex-shrink-0 items-center justify-center p-1 rounded-md text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900 transition-colors duration-200",
        data: { turbo_method: :delete, turbo_confirm: t("inspiration.notes.note.delete_confirm") },
        aria: { label: t("inspiration.notes.note.delete") } do %>
      <%= lucide_icon "trash-2", class: "w-3.5 h-3.5" %>
    <% end %>
  </div>
  <p class="mt-1 whitespace-pre-wrap break-words text-gray-900 dark:text-white"><%= note.body %></p>
</li>
