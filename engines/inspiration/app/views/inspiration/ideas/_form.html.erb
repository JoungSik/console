<%= form_with(
      model: idea,
      scope: :idea,
      url: idea.persisted? ? inspiration.idea_path(idea) : inspiration.ideas_path,
      class: "space-y-3",
      data: { controller: "bridge--form" }
    ) do |form| %>
  <% unless idea.persisted? %>
    <%= hidden_field_tag :status, local_assigns[:status_filter], id: nil %>
  <% end %>

  <% if idea.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-100 px-4 py-3 rounded-md">
      <h2 class="font-medium mb-2"><%= t("errors.messages.validation_failed", count: idea.errors.count, resource: idea.model_name.human) %></h2>
      <ul class="text-sm space-y-1">
        <% idea.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= form.text_field :title,
                        maxlength: Inspiration::Idea::MAX_TITLE_LENGTH,
                        placeholder: t("inspiration.ideas.form.title_placeholder"),
                        class: "w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :body, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= form.text_area :body,
                       rows: 4,
                       placeholder: t("inspiration.ideas.form.body_placeholder"),
                       class: "w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :reference_url, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= form.url_field :reference_url,
                       placeholder: "https://",
                       class: "w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
  </div>

  <% if idea.persisted? %>
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= form.select :status,
                      Inspiration::Idea.statuses.keys.map { |status| [ Inspiration::Idea.human_status(status), status ] },
                      {},
                      class: "w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>
  <% end %>

  <div class="flex justify-end">
    <%= form.submit idea.persisted? ? t("inspiration.ideas.form.submit_update") : t("inspiration.ideas.form.submit_create"),
                    data: { bridge__form_target: "submit", bridge_title: idea.persisted? ? t("actions.update") : t("actions.create") },
                    class: "inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800" %>
  </div>
<% end %>
