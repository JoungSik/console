<% if ideas.any? %>
  <%= render partial: "inspiration/ideas/idea", collection: ideas, as: :idea, locals: { index: true, status_filter: status_filter } %>
<% else %>
  <div class="text-center py-12">
    <%= lucide_icon "lightbulb", class: "mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" %>
    <h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-white"><%= t("inspiration.ideas.index.empty_title") %></h3>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("inspiration.ideas.index.empty_description") %></p>
  </div>
<% end %>
