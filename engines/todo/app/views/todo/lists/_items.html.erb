<% if list.items.exists? %>
  <div class="border-t border-gray-200 dark:border-gray-700 pt-6 space-y-3">
    <% list.sorted_items.each do |item| %>
      <div id="<%= dom_id item %>" class="flex items-center justify-between gap-2 p-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700">
        <div class="flex items-center gap-3 min-w-0">
          <%= button_to todo.list_item_path(list, item),
              method: :patch,
              params: { item: { completed: !item.completed? } },
              form_class: "flex-shrink-0",
              aria: { label: item.completed? ? "할 일 완료 해제" : "할 일 완료" } do %>
            <% if item.completed? %>
              <div class="w-5 h-5 bg-green-500 rounded border border-green-500 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
            <% else %>
              <div class="w-5 h-5 border-2 border-gray-300 dark:border-gray-500 rounded hover:border-green-400 transition-colors duration-200"></div>
            <% end %>
          <% end %>
          <span class="min-w-0 text-sm text-gray-900 dark:text-white break-words <%= item.completed? ? 'line-through text-gray-500 dark:text-gray-400' : '' %>">
            <%= item.title %>
          </span>
          <% if item.recurring? %>
            <span class="flex-shrink-0 text-gray-400 dark:text-gray-500" title="반복: <%= Todo::Item::RECURRENCE_LABELS[item.recurrence] %>">
              <%= lucide_icon "repeat", class: "w-4 h-4" %>
            </span>
          <% end %>
          <% if item.url? %>
            <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer"
               class="flex-shrink-0 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors duration-200"
               title="<%= item.url %>">
              <%= lucide_icon "external-link", class: "w-4 h-4" %>
            </a>
          <% end %>
        </div>
        <div class="flex flex-shrink-0 items-center gap-2">
          <% if item.due_date.present? %>
            <span class="text-xs <%= due_date_css_class(item) %>">
              <%= item.due_date.strftime("%Y-%m-%d") %>
            </span>
          <% end %>
          <%= button_to todo.list_item_path(list, item),
              method: :delete,
              class: "text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300",
              data: { turbo_confirm: "이 할 일을 삭제하시겠습니까?" },
              aria: { label: "할 일 삭제" } do %>
            <%= lucide_icon "trash-2", class: "w-4 h-4" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-8 border-t border-gray-200 dark:border-gray-700">
    <p class="text-gray-500 dark:text-gray-400">아직 할 일이 없습니다.</p>
  </div>
<% end %>
