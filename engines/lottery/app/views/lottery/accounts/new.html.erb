    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white" data-native-page-title><%= t("lottery.accounts.new.title") %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("lottery.accounts.new.description") %></p>
    </div>
    <%= render "form", account: @account %>
  </div>
</div>
