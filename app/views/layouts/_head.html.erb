<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">

<meta name="description" content="개인의 일상, 목표, 성과를 체계적으로 기록하고 관리할 수 있는 프라이빗 라이프 대시보드">
<meta name="keywords" content="라이프로그, 인생기록, 개인대시보드, 일기, 목표관리, 성과추적, 프라이빗, 자기계발">
<meta name="author" content="JoungSik">
<meta name="robots" content="index, follow">
<meta property="og:title" content="<%= content_for(:og_title) || "Console - 나만의 인생 기록을 위한 프라이빗 대시보드" %>">
<meta property="og:description" content="<%= content_for(:og_description) || "개인의 일상, 목표, 성과를 체계적으로 기록하고 관리할 수 있는 프라이빗 라이프 대시보드" %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= content_for(:og_url) || "https://console.joungsik.com" %>">
<meta property="og:image" content="https://console.joungsik.com/icon.png">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta property="og:locale" content="ko_KR">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<%= tag.link rel: "manifest", href: main_app.pwa_manifest_path(format: :json) %>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" data-theme-target="lightColor">
<meta name="theme-color" content="#1e40af" media="(prefers-color-scheme: dark)" data-theme-target="darkColor">

<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">

<%= stylesheet_link_tag "application", "lexxy", "tailwind", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "hotwire_native", "data-turbo-track": "reload" if hotwire_native_app? %>
<%= javascript_importmap_tags %>
