<% content_for(:title) { "포스트" } %>

<div id="posts-page" class="w-full">
  <div class="flex items-center justify-between gap-3 mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">포스트</h1>
  </div>

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-8">
    <%= turbo_frame_tag "post_composer", class: "block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm p-4 sm:p-5 mb-6 lg:sticky lg:top-8 lg:self-start lg:mb-0" do %>
      <%= render "form", post: @post %>
    <% end %>

    <div id="posts" class="space-y-3">
      <%= render "post_list", posts: @posts %>
    </div>
  </div>
</div>
